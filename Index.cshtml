@model IEnumerable<EmployeeManagement.Models.Employee>

<h1>Danh sách nhân viên</h1>

<table class="table">
    <thead>
        <tr>
            <th>Họ tên</th>
            <th>Chức vụ</th>
            <th>Phòng ban</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FullName</td>
                <td>@item.Position</td>
                <td>@item.Department.DepartmentName</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.EmployeeId">Detail</a>
                </td>
            </tr>
        }
    </tbody>
</table>