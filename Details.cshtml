@model EmployeeManagement.Models.Employee

<h1>Chi tiết nhân viên</h1>

<div>
    <h4>Nhân viên</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Họ tên</dt>
        <dd class="col-sm-10">@Model.FullName</dd>
        <dt class="col-sm-2">Chức vụ</dt>
        <dd class="col-sm-10">@Model.Position</dd>
        <dt class="col-sm-2">Phòng ban</dt>
        <dd class="col-sm-10">@Model.Department.DepartmentName</dd>
    </dl>
</div>
<div>
    <a asp-action="Index">Quay lại danh sách</a>
</div>